#!/bin/bash

USER_NAME=$(git config user.name)

if [ "$USER_NAME" = "ratchet535" ]; then
  exit 0
fi

if git diff --cached --name-only | grep -q '\\320\\233\\320\\265\\320\\272\\321\\206\\320\\270\\320\\270 \\320\\270 \\320\\273\\320\\260\\320\\261\\320\\276\\321\\200\\320\\260\\321\\202\\320\\276\\321\\200\\320\\275\\321\\213\\320\\265'; then
  echo " Вы не можете модифицировать папку с лекциями! Пожалуйста, отмените изменения в вашем коммите и попробуйте еще раз!"
  exit 1
fi

if git diff --cached --name-only | grep -q '/\\320\\221\\320\\276\\321\\200\\320\\276\\320\\267\\320\\265\\320\\275\\320\\265\\321\\206 \\320\\224\\320\\260\\320\\262\\320\\270\\320\\264/'; then
  echo " Вы не можете модифицировать мою папку! Пожалуйста, отмените изменения в вашем коммите и попробуйте еще раз!"
  exit 1
fi

if git diff --cached --name-only | grep -q '12.xlsx'; then
  echo " Вы не можете модифицировать журнал! Пожалуйста, отмените изменения в вашем коммите и попробуйте еще раз!"
  exit 1
fi

exit 0
